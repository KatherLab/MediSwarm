    libtasn1-6 \
    libudev1 \
    libuuid1 \
    linux-libc-dev \
    logsave \
    mount \
    openssl \
    util-linux \
    apt-transport-https \
    curl \
    dirmngr \
    distro-info-data \
    gnupg-l10n \
    gnupg-utils \
    gnupg \
    gpg-agent \
    gpg-wks-client \
    gpg-wks-server \
    gpg \
    gpgconf \
    gpgsm \
    libassuan0 \
    libbrotli1 \
    libcurl4 \
    libksba8 \
    libldap-2.5-0 \
    libldap-common \
    libnghttp2-14 \
    libnpth0 \
    libpsl5 \
    librtmp1 \
    libsasl2-2 \
    libsasl2-modules-db \
    libsasl2-modules \
    libssh-4 \
    lsb-release \
    pinentry-curses \
    publicsuffix \
    unzip \
    zip \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Stage 4: NVFlare from source (changes with NVFlare updates)
# ---------------------------------------------------------------------------
#
# CACHE NOTE: master_template.yml is NOT content-stable across commits.
# buildDockerImageAndStartupKits.sh rewrites its placeholders before the build:
#   __REPLACED_BY_CURRENT_VERSION_NUMBER_WHEN_BUILDING_DOCKER_IMAGE__ -> <version>-dev.<date>.<git short hash>
#   __REPLACED_BY_CONTAINER_VERSION_IDENTIFIER_WHEN_BUILDING_DOCKER_IMAGE__ -> <git short hash>
# Both embed the commit hash, so the file's CONTENT differs on every commit and
# this COPY is a genuine cache miss -- not an mtime artefact (Docker excludes
# mtime from COPY checksums). Everything below this line therefore rebuilds on
# every commit, which is precisely why the static layers sit at the top.

# install ODELIA fork of NVFlare from the source shipped in stage 1. Built from a
# scratch copy at the path earlier images used, so the installed package (and its
# recorded source URL) is unchanged and the shipped tree gets no build artefacts.
WORKDIR /workspace/
RUN cp -r /MediSwarm/docker_config/NVFlare /workspace/nvflare \
    && python3 -m pip install --no-cache-dir /workspace/nvflare \
    && rm -rf /workspace/nvflare
## Override with MediSwarm master_template.yml (contains version placeholders injected by build script)
COPY ./MediSwarm/docker_config/master_template.yml /tmp/master_template.yml
RUN mv /tmp/master_template.yml $(python3 -c "import nvflare.lighter,os;print(os.path.dirname(nvflare.lighter.__file__))")/templates/master_template.yml

# ---------------------------------------------------------------------------
# Stage 5: application code (changes every commit)
# ---------------------------------------------------------------------------

# Copy the source code for local training and deploying to the swarm
# (without pretrained_weights/ and docker_config/NVFlare/, which stage 1 added)
COPY ./MediSwarm /MediSwarm
# Replace symlinks with actual copies so NVFlare's os.walk()-based job signing
# and zip utilities can traverse all directories (os.walk does not follow symlinks)
RUN find /MediSwarm -type l | while read link; do \
        target=$(readlink -f "$link") && \
        rm "$link" && \
        if [ -d "$target" ]; then cp -r "$target" "$link"; \
        elif [ -f "$target" ]; then cp "$target" "$link"; fi; \
    done
RUN mkdir -p /fl_admin/transfer && ln -s /MediSwarm /fl_admin/transfer/MediSwarm

# allow creating home directory for local user inside container if needed
RUN chmod a+rwx /home
