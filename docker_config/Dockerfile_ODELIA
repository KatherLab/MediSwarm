# Use the specified PyTorch image as the base.
# Pinned by DIGEST, not just by tag: a tag is mutable and can be re-pushed under
# us, so the digest is the only thing here that actually makes a build
# reproducible. Bump it deliberately (see .github/workflows/daily-image-verify.yml).
ARG PYTORCH_IMAGE=pytorch/pytorch:2.2.2-cuda12.1-cudnn8-runtime@sha256:923f687790bec78081c357e71dcd5dcef80b0cc00f6c34484902a5e83362c854
FROM ${PYTORCH_IMAGE}

# Specify the NVFlare version
ARG NVF_VERSION=2.8.0
ENV NVF_BRANCH=${NVF_VERSION}

# Three OpenMP runtimes end up in this image: numpy (conda/MKL) loads LLVM's
# libomp, torch (pip) loads GNU libgomp, scikit-learn bundles its own libgomp.
# LLVM's runtime aborts the process when it finds another one already
# initialised ("OMP: Error #15") -- intermittently, depending on which library
# initialises first. That kills a client's worker within a second of job
# launch, and the coordinator then only sees a site that "had not configured"
# (#596; hit CAM_1 in production on 2026-04-08). This is the documented
# escape hatch: the error becomes a warning. The proper fix is a single
# runtime (numpy without MKL); until then this line must stay.
ENV KMP_DUPLICATE_LIB_OK=TRUE

# ===========================================================================
# Layer ordering strategy (build cache and download size):
#
# 1. Static content FIRST: pretrained weights, the torch.hub and Hugging Face
#    caches, the NVFlare source. ~3.7 GB that changes only when a weight or the
#    NVFlare pin changes. Each is its own COPY layer at the bottom, so with the
#    docker cache (--use-docker-cache) a pip, apt or code change neither rebuilds
#    nor re-ships it. Before 1.9.0 the weights rode in the per-commit code layer.
# 2. pip installs (expensive to rebuild, change rarely)
# 3. apt installs (change more often due to CVE version bumps, but are fast to
#    rebuild)
# 4. NVFlare install + master_template.yml (the template is stamped with this
#    build's version/commit hash, so it is a cache miss on EVERY commit --
#    nothing cacheable may sit below it; see the CACHE NOTE at that stage)
# 5. COPY source code (changes every build — must be last)
#
# The base pytorch image already includes python3 + pip, so pip installs
# don't depend on the apt python packages below — those are just security
# version updates.
#
# The final filesystem is the one earlier layouts produced; only the layer an
# item lives in moved.
# ===========================================================================

# ---------------------------------------------------------------------------
# Stage 1: static content (multi-GB, rarely changes)
# ---------------------------------------------------------------------------

# scripts/build/_cacheAndCopyPretrainedModelWeights.sh fills these build-context
# directories from the build cache after checking every file's SHA-256. The
# challenge weights (and SAM-Med2D for MST_SAMMed2D) stay OUT of the job folders:
# NVFlare ships a whole job folder to every client on submit.
COPY ./pretrained_weights /MediSwarm/pretrained_weights
COPY ./torch_home_cache /torch_home
# Already world-writable in the build context (huggingface_hub writes lock files
# into the cache at load time and the containers run as the site's user). A
# 'RUN chmod -R' here used to store the whole tree a second time.
COPY ./hf_home_cache /huggingface_home

# The NVFlare fork's source as shipped at /MediSwarm/docker_config/NVFlare (also
# what stage 4 installs). The build script moves it out of MediSwarm/ in the
# build context so the per-commit code layer no longer carries it a second time.
COPY ./nvflare_source /MediSwarm/docker_config/NVFlare

# ---------------------------------------------------------------------------
# Stage 2: Python packages (expensive, rarely changes)
# ---------------------------------------------------------------------------

# uninstall conda to prevent usage and avoid potential repository license issues.
# pyOpenSSL (from the base image) goes as well: nothing imports it (urllib3 2.x
# never injects it), and it holds cryptography below 43 and carries a HIGH CVE.
RUN python3 -m pip uninstall -y conda conda-package-handling conda_index pyOpenSSL

# Install specific versions of pip, setuptools and wheel. setuptools 80.10 still
# ships pkg_resources and vendors fixed jaraco.context/wheel copies; wheel 0.46
# needs packaging >= 24, which is pinned with it.
RUN python3 -m pip install --no-cache-dir \
    -U \
    pip==25.2 \
    setuptools==80.10.2 \
    wheel==0.46.3 \
    packaging==24.2

# Install dependencies of NVFlare and application packages in a single layer.
# Using --no-cache-dir avoids writing pip's download cache to the layer,
# reducing image size and eliminating the need for a separate cache purge.
#
# NVFlare's wire stack (grpcio, protobuf, msgpack here; aiohttp below, which
# carries the 'http' scheme the ODELIA kits use) stays EXACTLY as in 1.8.1: sites
# move to a new image at different times and a run mixes both. Known CVEs in
# them are accepted in .trivyignore, with the reason.
RUN python3 -m pip install --no-cache-dir \
    --upgrade \
    psutil==7.0.0 \
    Flask==3.0.2 \
    Flask-JWT-Extended==4.6.0 \
    Flask-SQLAlchemy==3.1.1 \
    PyJWT==2.14.0 \
    SQLAlchemy==2.0.16 \
    Werkzeug==3.0.6 \
    blinker==1.9.0 \
    docker==7.1.0 \
    greenlet==3.2.2 \
    grpcio==1.62.1 \
    gunicorn==23.0.0 \
    itsdangerous==2.2.0 \
    msgpack==1.1.0 \
    protobuf==4.24.4 \
    pyhocon==0.3.61 \
    pyparsing==3.2.3 \
    websockets==15.0.1

# Install additional Python packages for application code at defined versions.
# 1.9.0 removed wandb (its bundled wandb-core binary alone had 56 HIGH/CRITICAL
# CVEs) and datasets, with the packages only they pulled in (GitPython, gitdb,
# smmap, docker-pycreds, sentry-sdk, setproctitle; pyarrow, multiprocess, dill,
# xxhash): no code in the image or in any job imports them.
RUN python3 -m pip install --no-cache-dir \
    Deprecated==1.2.18 \
    SimpleITK==2.5.0 \
    absl-py==2.2.2 \
    aiohttp==3.11.18 \
    aiosignal==1.3.2 \
    async-timeout==5.0.1 \
    cachetools==5.5.2 \
    contourpy==1.3.2 \
    cycler==0.12.1 \
    et-xmlfile==2.0.0 \
    fonttools==4.58.0 \
    frozenlist==1.6.0 \
    google-auth-oauthlib==1.2.2 \
    google-auth==2.40.2 \
    huggingface_hub==0.29.3 \
    coral_pytorch==1.4.0 \
    humanize==4.12.3 \
    joblib==1.5.1 \
    kiwisolver==1.4.8 \
    lightning-utilities==0.14.3 \
    markdown-it-py==3.0.0 \
    markdown==3.8 \
    matplotlib==3.9.2 \
    mdurl==0.1.2 \
    monai==1.4.0 \
    multidict==6.4.4 \
    nibabel==5.3.2 \
    oauthlib==3.2.2 \
    openpyxl==3.1.5 \
    pandas==2.2.3 \
    # PINNED (load-bearing): torch 2.2.2 comes from the base image and predates the
    # NumPy 2.0 ABI break. Unpinning pulls NumPy 2.x and breaks torch/SimpleITK/monai
    # at import. Do not relax without moving the base image first.
    numpy==1.26.4 \
    pyasn1-modules==0.4.2 \
    pyasn1==0.6.4 \
    pydicom==3.0.2 \
    python-dateutil==2.9.0.post0 \
    x-transformers==2.3.5 \
    pytorch-lightning==2.4.0 \
    requests==2.32.3 \
    requests-oauthlib==2.0.0 \
    rich==14.0.0 \
    rsa==4.9.1 \
    safetensors==0.5.3 \
    scikit-learn==1.5.2 \
    scipy==1.15.3 \
    seaborn==0.13.2 \
    einops==0.8.0 \
    shellingham==1.5.4 \
    tensorboard-data-server==0.7.2 \
    tensorboard-plugin-wit==1.8.1 \
    tensorboard==2.19.0 \
    threadpoolctl==3.6.0 \
    timm==1.0.15 \
    torchio==0.20.1 \
    torchmetrics==1.7.1 \
    # PINNED (load-bearing): exact companion releases of the torch 2.2.2 that ships in
    # the base image. Unpinning makes pip resolve newer builds and silently replace
    # the CUDA torch from the base image.
    torchvision==0.17.2 \
    torchaudio==2.2.2 \
    tqdm==4.67.0 \
    typer==0.15.4 \
    tzdata==2025.2 \
    wrapt==1.17.2 \
    yarl==1.20.0 \
    aiohappyeyeballs==2.6.1 \
    annotated-types==0.7.0 \
    dynamic-network-architectures==0.4.3 \
    einx==0.3.0 \
    frozendict==2.4.6 \
    hf-xet==1.1.2 \
    importlib-resources==6.5.2 \
    loguru==0.7.3 \
    propcache==0.3.1 \
    pydantic==2.11.5 \
    pydantic-core==2.33.2 \
    typing-extensions==4.13.2 \
    typing-inspection==0.4.1 \
    # Fixed releases of packages that come with the base image (HIGH CVEs in the
    # base versions). Only used by requests/huggingface_hub (urllib3, Brotli) and
    # by leftovers of the removed conda (soupsieve).
    urllib3==2.8.0 \
    Brotli==1.2.0 \
    soupsieve==2.8.4

# Install packages needed for listing licenses and creating SBOM
RUN python3 -m pip install --no-cache-dir \
    pip-licenses==5.0.0 \
    prettytable==3.16.0 \
    defusedxml==0.7.1 \
    distro2sbom==0.6.0 \
    lib4sbom==0.8.4 \
    semantic-version==2.10.0

# ---------------------------------------------------------------------------
# Stage 3: apt packages (deliberately UNPINNED)
# ---------------------------------------------------------------------------
# apt installs the current patch version on purpose. Exact pins here gave us
# neither reproducibility (the base image floats unless pinned by digest -- see
# above) nor security: a pin FREEZES an old patch version while the Ubuntu archive
# garbage-collects it, so pinned builds simultaneously miss security updates AND
# break once the pinned version is dropped from the mirror (#395).
# Security comes from the daily CVE scan of the built image
# (.github/workflows/daily-image-verify.yml), not from freezing versions here.
# If bit-for-bit apt reproducibility is ever genuinely needed, that is
# snapshot.ubuntu.com -- pins against a live archive cannot provide it in principle.
#
# Kept after the pip installs so apt changes don't invalidate the expensive pip
# layers above.

RUN apt update && apt install -y \
    apt \
    apt-utils \
    libapt-pkg6.0 \
    libexpat1 \
    libmpdec3 \
    libpython3-stdlib \
    libpython3.10-minimal \
    libpython3.10-stdlib \
    libreadline8 \
    libsqlite3-0 \
    media-types \
    python3-minimal \
    python3.10-minimal \
    python3.10 \
    python3 \
    readline-common \
    base-files \
    bash \
    bsdutils \
    ca-certificates \
    coreutils \
    dpkg \
    e2fsprogs \
    gpgv \
    libblkid1 \
    libc-bin \
    libc-dev-bin \
    libc6-dev \
    libc6 \
    libcap2 \
    libcom-err2 \
    libext2fs2 \
    libgnutls30 \
    libgssapi-krb5-2 \
    libk5crypto3 \
    libkrb5-3 \
    libkrb5support0 \
    libmount1 \
    libpam-modules-bin \
    libpam-modules \
    libpam-runtime \
    libpam0g \
    libseccomp2 \
    libsmartcols1 \
    libss2 \
    libssl3 \
