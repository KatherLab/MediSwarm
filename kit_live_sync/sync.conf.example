#!/usr/bin/env bash

REMOTE_HOST="100.100.100.165"
REMOTE_USER="mediswarm-upload"
REMOTE_BASE="/srv/mediswarm/live"

LOG_SYNC_INTERVAL=30
CKPT_SYNC_INTERVAL=180

SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o ConnectTimeout=5"

# What leaves the site (1.9.0 kits). Logs, heartbeats, TensorBoard event files and metric
# summaries are always uploaded. An environment variable of the same name wins over this file.
#
# Model files (*.ckpt, *.pt) stay at the site unless this is 1.
#MEDISWARM_SYNC_MODELS=1
#
# Per-case prediction CSVs (one row per case) are uploaded only if this site opted in to
# per-case return (--env ODELIA_RETURN_PER_CASE=1 in MEDISWARM_DOCKER_OPTIONS of
# startup/image.conf). 1 = upload them anyway, 0 = never. A job that sets
# ODELIA_RETURN_PER_CASE=0 (DP jobs) keeps them at the site either way.
#MEDISWARM_SYNC_PREDICTIONS=0
#
# The swarm daemon ends this many minutes after the kit's client container stopped (0 = never).
#MEDISWARM_SYNC_CONTAINER_GONE_MINUTES=10

# >>> kit upload key >>>
# Kits from 1.9.0 on carry this site's own upload key (startup/upload_key) and the upload
# host's public key (startup/upload_known_hosts). When both files are next to this file,
# live sync logs in with that key only and refuses a host that does not show that host
# key, instead of offering this account's own ~/.ssh keys to an unchecked host. The options
# go in front of SSH_OPTS because ssh keeps the first value it gets for an option. A kit
# without the two files keeps SSH_OPTS as it is; so does a site that assigns SSH_OPTS
# itself after this block. The build adds this block to every kit's sync.conf, so leave it
# here even when you edit the settings above.
_kit_upload_dir="$(cd -- "$(dirname -- "${BASH_SOURCE:-/nonexistent/sync.conf}")" 2>/dev/null && pwd)" || _kit_upload_dir=""
if [ -n "$_kit_upload_dir" ] && [ -f "$_kit_upload_dir/upload_key" ] && [ -f "$_kit_upload_dir/upload_known_hosts" ]; then
  case "$_kit_upload_dir" in
    *[!A-Za-z0-9._/+:@,=-]*)
      # SSH_OPTS is split on blanks, so a path with blanks or wildcards cannot go in.
      echo "[WARN] sync.conf: cannot use the kit upload key from '$_kit_upload_dir' (blank or special character in the path); move the kit to a plain path." >&2
      ;;
    *)
      # ssh ignores a private key that others can read (e.g. after an unzip that drops modes)
      if [ -O "$_kit_upload_dir/upload_key" ]; then chmod go-rwx "$_kit_upload_dir/upload_key" 2>/dev/null || true; fi
      SSH_OPTS="-i $_kit_upload_dir/upload_key -o IdentitiesOnly=yes -o UserKnownHostsFile=$_kit_upload_dir/upload_known_hosts -o StrictHostKeyChecking=yes -o HostKeyAlias=mediswarm-upload-host -o CheckHostIP=no ${SSH_OPTS:-}"
      ;;
  esac
fi
# <<< kit upload key <<<
